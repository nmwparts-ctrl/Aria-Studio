<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>A527 1920x350 Rigid 1s Auto-Rotation English Board</title>
    <!-- High stability ECharts library -->
    <script src="https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js"></script>
<style>
    /* ==================== 1. 全局重置与径向背景光源 ==================== */
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }
    html, body {
        width: 100vw;
        height: 100vh;
        overflow: hidden !important; 
        background: #030406;
        color: #e2e8f0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace;
        position: relative;
        user-select: none;
    }

    /* 在背景深处加入暗光光源 */
    body::before {
        content: '';
        position: absolute;
        width: 450px;
        height: 250px;
        top: 5%;
        left: 15%;
        background: radial-gradient(circle, rgba(56, 189, 248, 0.12) 0%, transparent 75%);
        z-index: 0;
        pointer-events: none;
    }
    body::after {
        content: '';
        position: absolute;
        width: 500px;
        height: 250px;
        bottom: 5%;
        right: 15%;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.12) 0%, transparent 75%);
        z-index: 0;
        pointer-events: none;
    }

    .container {
        display: flex;
        width: 100vw;
        height: 100vh;
        padding: 0; 
        overflow: hidden;
        position: relative;
        z-index: 1;
    }

    /* ==================== 2. 三合一黑色磨砂扫边面板（旋转边框已移除） ==================== */
    .glass-board {
        position: relative;
        width: 100%;
        height: 100%;
        background: rgba(10, 10, 16, 0.2);
        padding: 1.5px; /* 轨道扫边发光线宽（保留边框占位，但无旋转光效） */
        display: flex;
        overflow: hidden;
        border-radius: 16px; 
    }

    /* 原科幻蓝紫扫边旋转层已移除 —— 取消显示旋转光 */
    /* .glass-board::before 已删除 */

    /* 核心磨砂透明玻璃容器 */
    .glass-board-inner {
        position: relative;
        z-index: 2;
        display: flex;
        width: 100%;
        height: 100%;
        background: transparent; 
        overflow: hidden;
        border-radius: 14.5px; 
    }

    /* ==================== 3. 3D 核心视口与左侧高透导航菜单 ==================== */
    .sidebar-col {
        width: 210px;
        height: 100%;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        padding: 24px 20px;
        gap: 14px;
        border-right: 1px solid rgba(255, 255, 255, 0.05);
        background: rgba(8, 8, 12, 0.35); 
        backdrop-filter: blur(24px) saturate(130%);
        -webkit-backdrop-filter: blur(24px) saturate(130%);
        overflow: hidden;
        
        /* 启用 3D 视口透视与子级三维立体呈现 */
        perspective: 800px;
        transform-style: preserve-3d;
    }

    /* 3D 菜单选项基础设计 */
    .menu-item {
        display: flex;
        align-items: center;
        gap: 12px;
        color: rgba(255, 255, 255, 0.38);
        text-decoration: none;
        font-size: 15px;
        font-weight: 500;
        height: 32px;
        cursor: pointer;
        transition: color 0.3s ease, transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
        
        /* 子元素保持 3D 转换 */
        transform-style: preserve-3d;
        transform: translateZ(0) rotateY(0deg);
    }

    /* 3D 悬停及激活态：向外突起并带有侧向旋转偏角 */
    .menu-item:hover {
        color: rgba(255, 255, 255, 0.8);
        transform: translateZ(10px) rotateY(-5deg);
    }
    .menu-item.active {
        color: #ffffff;
        transform: translateZ(18px) rotateY(-10deg);
    }

    /* 图标 3D 浮动层深与厚重阴影 */
    .menu-item svg {
        color: rgba(255, 255, 255, 0.38);
        fill: currentColor;
        transition: color 0.3s ease, transform 0.4s ease, filter 0.3s ease;
        flex-shrink: 0;
        
        /* 悬浮在文字之上的 z 轴高度 */
        transform: translateZ(6px);
        /* 生成立体厚度投影 */
        filter: drop-shadow(1px 1px 0px rgba(0,0,0,0.8)) drop-shadow(2px 3px 2px rgba(0,0,0,0.6));
    }
    .menu-item:hover svg {
        transform: translateZ(12px) scale(1.05);
    }
    .menu-item.active svg {
        color: #ffffff;
        transform: translateZ(18px) scale(1.1);
        filter: drop-shadow(0px 0px 6px rgba(56, 189, 248, 0.6)) drop-shadow(1px 1px 1px rgba(0,0,0,0.9)) drop-shadow(2px 3px 3px rgba(0,0,0,0.7));
    }

    /* 导航文字多层 3D 字幕阴影 */
    .menu-item span {
        transition: transform 0.4s ease;
        transform: translateZ(3px);
        text-shadow: 1px 1px 0px rgba(0,0,0,0.9), 2px 2px 2px rgba(0,0,0,0.4);
    }
    .menu-item:hover span {
        transform: translateZ(8px);
    }
    .menu-item.active span {
        transform: translateZ(14px);
        /* 拟重叠雕刻阴影 */
        text-shadow: 1px 1px 0px rgba(0,0,0,0.9), 2px 2px 1px rgba(0,0,0,0.7), 3px 3px 3px rgba(0,0,0,0.4);
    }

    /* ==================== 4. 中间分栏：数据图表与3D标题 ==================== */
    .chart-col {
        flex: 1;
        height: 100%;
        padding: 16px 20px;
        display: flex;
        flex-direction: column;
        min-width: 0;
        border-right: 1px solid rgba(255, 255, 255, 0.05);
        background: rgba(8, 8, 12, 0.75);
        backdrop-filter: blur(32px) saturate(140%);
        -webkit-backdrop-filter: blur(32px) saturate(140%);
        overflow: hidden;
        
        perspective: 800px;
        transform-style: preserve-3d;
    }
    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        height: 24px;
        flex-shrink: 0;
        margin-bottom: 6px;
        transform-style: preserve-3d;
    }
    .chart-title-group {
        display: flex;
        align-items: center;
        gap: 8px;
        transform-style: preserve-3d;
    }
    /* 采用拟雕刻硬质 3D 文字结构 */
    .chart-main-title {
        font-size: 13px;
        font-weight: bold;
        color: #ffffff;
        transform: translateZ(10px);
        text-shadow: 0 1px 0 #1e293b, 1px 1.5px 0px rgba(0,0,0,0.9), 2px 2.5px 2px rgba(0,0,0,0.5);
    }
    .chart-subtitle {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.4);
        transform: translateZ(4px);
        text-shadow: 1px 1px 0px rgba(0,0,0,0.9);
    }
    .indicator-pill {
        background-color: rgba(255, 255, 255, 0.08);
        color: #38bdf8;
        font-size: 10px;
        padding: 1px 6px;
        border-radius: 3px;
        font-family: monospace;
        font-weight: bold;
        transform: translateZ(8px);
        box-shadow: 1px 1px 0px rgba(0,0,0,0.9), inset 0px 1px 0px rgba(255,255,255,0.05);
    }
    #chart-container {
        width: 100%;
        flex: 1;
        min-height: 0;
    }

    /* ==================== 5. 右侧分栏：高透光 3D 加密货币面板 ==================== */
    .crypto-col {
        width: 250px;
        height: 100%;
        flex-shrink: 0;
        padding: 16px 18px;
        display: flex;
        flex-direction: column;
        background: rgba(8, 8, 12, 0.35);
        backdrop-filter: blur(24px) saturate(130%);
        -webkit-backdrop-filter: blur(24px) saturate(130%);
        overflow: hidden;
        
        perspective: 800px;
        transform-style: preserve-3d;
    }
    .crypto-title-bar {
        font-size: 11px;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.35);
        margin-bottom: 6px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        padding-bottom: 4px;
        display: flex;
        justify-content: space-between;
        flex-shrink: 0;
        transform-style: preserve-3d;
    }
    .crypto-title-bar span {
        transform: translateZ(6px);
        text-shadow: 1px 1px 0px rgba(0,0,0,0.9);
    }
    .crypto-list {
        display: flex;
        flex-direction: column;
        height: 100%;
        justify-content: space-between;
        transform-style: preserve-3d;
    }
    
    /* 每一个卡片具有独立的 3D 浮动与深度倾斜过渡 */
    .crypto-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 4px 6px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.02);
        border-radius: 6px;
        transition: transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1), background-color 0.3s;
        
        transform-style: preserve-3d;
        transform: translateZ(0);
    }
    .crypto-item:hover {
        background-color: rgba(255, 255, 255, 0.02);
        transform: translateZ(12px) rotateX(4deg);
    }
    
    .crypto-meta {
        display: flex;
        flex-direction: column;
        transform-style: preserve-3d;
        transform: translateZ(4px);
    }
    .crypto-name {
        font-size: 12px;
        font-weight: bold;
        color: #ffffff;
        text-shadow: 1px 1px 0px rgba(0,0,0,0.9), 2px 2px 2px rgba(0,0,0,0.4);
    }
    .crypto-symbol {
        font-size: 10px;
        color: rgba(255, 255, 255, 0.35);
        text-shadow: 1px 1px 0px rgba(0,0,0,0.9);
    }
    
    .crypto-data {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        transform-style: preserve-3d;
        transform: translateZ(8px);
    }
    /* 使得数据值更加凸显 */
    .crypto-price {
        font-size: 12px;
        font-weight: 600;
        font-family: 'Consolas', monospace;
        text-shadow: 1px 1px 0px rgba(0,0,0,0.9), 2px 2px 1px rgba(0,0,0,0.6);
    }
    .crypto-change {
        font-size: 10px;
        font-weight: 500;
        font-family: 'Consolas', monospace;
        text-shadow: 1px 1px 0px rgba(0,0,0,0.9);
    }

    /* 涨跌幅颜色调节 */
    .up { color: #10b981 !important; }
    .down { color: #f43f5e !important; }
    .flat { color: #94a3b8 !important; }
</style>
</head>  
<body>  
<div class="container">  
    <div class="glass-board">  
        <div class="glass-board-inner">  
            
            <!-- 1. 左侧分栏：高透光 3D 导航菜单 -->  
            <div class="sidebar-col" id="sidebar-menu">  
                <div class="menu-item active" data-target="overview">  
                    <svg viewBox="0 0 24 24" width="18" height="18">  
                        <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>  
                    </svg>  
                    <span>Overview</span>  
                </div>  
                <div class="menu-item" data-target="allocation">  
                    <svg viewBox="0 0 24 24" width="18" height="18">  
                        <path d="M21 18c0 1.1-.9 2-2 2H5c-1.11 0-2-.9-2-2V6c0-1.1.89-2 2-2h14c1.1 0 2 .9 2 2v12zm-2 0V6H5v12h14zm-3-5c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5.67 1.5 1.5 1.5 1.5-.67 1.5-1.5z"/>  
                    </svg>  
                    <span>Allocation</span>  
                </div>  
                <div class="menu-item" data-target="transactions">  
                    <svg viewBox="0 0 24 24" width="18" height="18">  
                        <path d="M19 9H5.83l2.59-2.59L7 5l-5 5 5 5 1.41-1.41L5.83 11H19V9zm-14 6h13.17l-2.59 2.59L17 19l5-5-5-5-1.41 1.41 2.59 2.59H5v2z"/>  
                    </svg>  
                    <span>Transactions</span>  
                </div>  
                <div class="menu-item" data-target="investment">  
                    <svg viewBox="0 0 24 24" width="18" height="18">  
                        <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/>  
                    </svg>  
                    <span>Investment</span>  
                </div>  
                <div class="menu-item" data-target="spending">  
                    <svg viewBox="0 0 24 24" width="18" height="18">  
                        <path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/>  
                    </svg>  
                    <span>Spending</span>  
                </div>  
            </div>  

            <!-- 2. 中间分栏：数据图表 -->  
            <div class="chart-col">  
                <div class="chart-header">  
                    <div class="chart-title-group">  
                        <span class="chart-main-title" id="chart-main-title">Asset Overview</span>  
                        <span class="chart-subtitle" id="chart-sub-title">System analytics processing</span>  
                    </div>  
                    <span class="indicator-pill" id="mode-pill">OVERVIEW</span>  
                </div>  
                <div id="chart-container"></div>  
            </div>  

            <!-- 3. 右侧分栏：高透光行情面板 -->  
            <div class="crypto-col">  
                <div class="crypto-title-bar">  
                    <span>CRYPTO ECOSYSTEM</span>  
                    <span style="color: #10b981;">● SYNCED</span>  
                </div>  
                <div class="crypto-list">  
                    <div class="crypto-item" id="crypto-BTC">  
                        <div class="crypto-meta"><span class="crypto-name">Bitcoin</span><span class="crypto-symbol">BTC/USD</span></div>  
                        <div class="crypto-data"><span class="crypto-price flat" id="btc-price">0.00</span><span class="crypto-change flat" id="btc-change">0.00%</span></div>  
                    </div>  
                    <div class="crypto-item" id="crypto-ETH">  
                        <div class="crypto-meta"><span class="crypto-name">Ethereum</span><span class="crypto-symbol">ETH/USD</span></div>  
                        <div class="crypto-data"><span class="crypto-price flat" id="eth-price">0.00</span><span class="crypto-change flat" id="eth-change">0.00%</span></div>  
                    </div>  
                    <div class="crypto-item" id="crypto-SOL">  
                        <div class="crypto-meta"><span class="crypto-name">Solana</span><span class="crypto-symbol">SOL/USD</span></div>  
                        <div class="crypto-data"><span class="crypto-price flat" id="sol-price">0.00</span><span class="crypto-change flat" id="sol-change">0.00%</span></div>  
                    </div>  
                    <div class="crypto-item" id="crypto-BNB">  
                        <div class="crypto-meta"><span class="crypto-name">Binance Coin</span><span class="crypto-symbol">BNB/USD</span></div>  
                        <div class="crypto-data"><span class="crypto-price flat" id="bnb-price">0.00</span><span class="crypto-change flat" id="bnb-change">0.00%</span></div>  
                    </div>  
                </div>  
            </div>  

        </div>  
    </div>  
</div>  
<script>  
    let myChart = null;  
    let rotationTimer = null;  
    let cryptoTimer = null;  

    // 重新映射的目标标识符，与左侧新面板属性匹配  
    const menuTargets = ["overview", "allocation", "transactions", "investment", "spending"];  
    let currentIndex = 0;  

    const cryptoBaseData = {  
        btc: { base: 94250, change: 1.85, seed: 0.0003 },  
        eth: { base: 2640, change: -1.12, seed: 0.0005 },  
        sol: { base: 182.6, change: 4.89, seed: 0.0012 },  
        bnb: { base: 624.5, change: 0.15, seed: 0.0004 }  
    };  

    window.addEventListener('DOMContentLoaded', () => {  
        initChart();  
        executeRotationStep();  
        simulateCrypto();  

        // 统一时钟  
        rotationTimer = setInterval(executeRotationStep, 2000);  
        cryptoTimer = setInterval(simulateCrypto, 2000);  
    });  

    window.addEventListener('resize', () => {  
        if (myChart) myChart.resize();  
    });  

    function initChart() {  
        const container = document.getElementById('chart-container');  
        if (window.echarts && container) {  
            myChart = echarts.init(container, 'dark', { renderer: 'canvas' });  
        }  
    }  

    function executeRotationStep() {  
        const target = menuTargets[currentIndex];  
        
        const items = document.querySelectorAll('.menu-item');  
        items.forEach(el => {  
            if (el.getAttribute('data-target') === target) {  
                el.classList.add('active');  
            } else {  
                el.classList.remove('active');  
            }  
        });  

        renderTargetChart(target);  
        currentIndex = (currentIndex + 1) % menuTargets.length;  
    }  

    function renderTargetChart(target) {  
        const mainTitle = document.getElementById('chart-main-title');  
        const subTitle = document.getElementById('chart-sub-title');  
        const pill = document.getElementById('mode-pill');  

        if (target === 'overview') {  
            mainTitle.innerText = "Asset Overview";  
            subTitle.innerText = "Dynamic overview of balances across accounts";  
            pill.innerText = "OVERVIEW";  
            pill.style.color = "#38bdf8";  

            const mockLineData = Array.from({length: 40}, () => (15000 + Math.random() * 800));  
            drawOverviewLineChart(mockLineData);  
        }   
        else if (target === 'allocation') {  
            mainTitle.innerText = "Asset Allocation";  
            subTitle.innerText = "Token distribution in your primary web3 wallet";  
            pill.innerText = "ALLOCATION";  
            pill.style.color = "#a78bfa";  

            drawWalletPieChart();  
        }   
        else if (target === 'transactions') {  
            mainTitle.innerText = "Transaction History";  
            subTitle.innerText = "Inflows vs Outflows in recent intervals";  
            pill.innerText = "TRANSACTIONS";  
            pill.style.color = "#10b981";  

            drawTransferBarChart();  
        }   
        else if (target === 'investment') {  
            mainTitle.innerText = "Investment Performance";  
            subTitle.innerText = "Multi-timeframe candlestick performance";  
            pill.innerText = "INVESTMENT";  
            pill.style.color = "#f43f5e";  

            drawInvestKLineChart();  
        }   
        else if (target === 'spending') {  
            mainTitle.innerText = "Consumer Spending";  
            subTitle.innerText = "Category breakdown of merchant spending";  
            pill.innerText = "SPENDING";  
            pill.style.color = "#f59e0b";  

            drawShopHorizontalChart();  
        }  
    }  

    /* ==================== ECharts 数据图形具体绘制逻辑 ==================== */  

    function drawOverviewLineChart(data) {  
        myChart.setOption({  
            backgroundColor: 'transparent',  
            grid: { top: 12, bottom: 12, left: 45, right: 15 },  
            xAxis: {  
                type: 'category', show: true,  
                axisLabel: { show: false }, axisLine: { lineStyle: { color: 'rgba(255,255,255,0.06)' } }, axisTick: { show: false }  
            },  
            yAxis: {  
                type: 'value', scale: true, splitNumber: 3,  
                axisLine: { show: false }, axisTick: { show: false },  
                splitLine: { lineStyle: { color: 'rgba(255,255,255,0.02)', type: 'dashed' } },  
                axisLabel: { color: 'rgba(255,255,255,0.4)', fontSize: 9 }  
            },  
            series: [{  
                type: 'line', data: data, showSymbol: false, smooth: true,  
                lineStyle: { color: '#38bdf8', width: 1.5 },  
                areaStyle: {  
                    color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [  
                        { offset: 0, color: 'rgba(56, 189, 248, 0.12)' },  
                        { offset: 1, color: 'transparent' }  
                    ])  
                }  
            }]  
        }, true);  
    }  

    function drawWalletPieChart() {  
        myChart.setOption({  
            backgroundColor: 'transparent',  
            series: [{  
                type: 'pie',  
                radius: ['45%', '70%'],  
                center: ['50%', '50%'],  
                avoidLabelOverlap: false,  
                itemStyle: { borderRadius: 4 },  
                label: { show: true, color: 'rgba(255,255,255,0.45)', fontSize: 9, formatter: '{b}: {d}%' },  
                labelLine: { lineStyle: { color: 'rgba(255,255,255,0.08)' }, length: 8, length2: 6 },  
                data: [  
                    { value: 45, name: 'BTC', itemStyle: { color: '#f59e0b' } },  
                    { value: 28, name: 'ETH', itemStyle: { color: '#6366f1' } },  
                    { value: 17, name: 'SOL', itemStyle: { color: '#14b8a6' } },  
                    { value: 10, name: 'Stable', itemStyle: { color: '#10b981' } }  
                ]  
            }]  
        }, true);  
    }  

    function drawTransferBarChart() {  
        const inflows = Array.from({length: 12}, () => Math.floor(Math.random() * 500 + 200));  
        const outflows = Array.from({length: 12}, () => Math.floor(Math.random() * 400 + 100));  
        myChart.setOption({  
            backgroundColor: 'transparent',  
            grid: { top: 12, bottom: 12, left: 45, right: 15 },  
            xAxis: {  
                type: 'category', show: true,  
                axisLabel: { show: false }, axisLine: { lineStyle: { color: 'rgba(255,255,255,0.06)' } }, axisTick: { show: false }  
            },  
            yAxis: {  
                type: 'value', scale: true, splitNumber: 3,  
                axisLine: { show: false }, axisTick: { show: false },  
                splitLine: { lineStyle: { color: 'rgba(255,255,255,0.02)', type: 'dashed' } },  
                axisLabel: { color: 'rgba(255,255,255,0.4)', fontSize: 9 }  
            },  
            series: [  
                {  
                    name: 'Inflow', type: 'bar', data: inflows, barWidth: 6,  
                    itemStyle: { color: '#10b981', borderRadius: [2, 2, 0, 0] }  
                },  
                {  
                    name: 'Outflow', type: 'bar', data: outflows, barWidth: 6,  
                    itemStyle: { color: '#f43f5e', borderRadius: [2, 2, 0, 0] }  
                }  
            ]  
        }, true);  
    }  

    function drawInvestKLineChart() {  
        const kData = [];  
        let startVal = 200;  
        for (let i = 0; i < 25; i++) {  
            const open = startVal + (Math.random() - 0.5) * 10;  
            const close = open + (Math.random() - 0.48) * 15;  
            const low = Math.min(open, close) - Math.random() * 5;  
            const high = Math.max(open, close) + Math.random() * 5;  
            kData.push([open.toFixed(2), close.toFixed(2), low.toFixed(2), high.toFixed(2)]);  
            startVal = close;  
        }  
        myChart.setOption({  
            backgroundColor: 'transparent',  
            grid: { top: 12, bottom: 12, left: 45, right: 15 },  
            xAxis: {  
                type: 'category', show: true,  
                axisLabel: { show: false }, axisLine: { lineStyle: { color: 'rgba(255,255,255,0.06)' } }, axisTick: { show: false }  
            },  
            yAxis: {  
                type: 'value', scale: true, splitNumber: 3,  
                axisLine: { show: false }, axisTick: { show: false },  
                splitLine: { lineStyle: { color: 'rgba(255,255,255,0.02)', type: 'dashed' } },  
                axisLabel: { color: 'rgba(255,255,255,0.4)', fontSize: 9 }  
            },  
            series: [{  
                type: 'candlestick',  
                data: kData,  
                itemStyle: {  
                    color: '#10b981',  
                    color0: '#f43f5e',  
                    borderColor: '#10b981',  
                    borderColor0: '#f43f5e'  
                }  
            }]  
        }, true);  
    }  

    function drawShopHorizontalChart() {  
        myChart.setOption({  
            backgroundColor: 'transparent',  
            grid: { top: 15, bottom: 15, left: 65, right: 20 },  
            xAxis: { type: 'value', show: false },  
            yAxis: {  
                type: 'category',  
                data: ['Tech Gear', 'Dining', 'Services', 'Travel'],  
                axisLine: { show: false }, axisTick: { show: false },  
                axisLabel: { color: 'rgba(255,255,255,0.45)', fontSize: 10 }  
            },  
            series: [{  
                type: 'bar',  
                data: [420, 280, 190, 110],  
                barWidth: 10,  
                itemStyle: {  
                    color: new echarts.graphic.LinearGradient(1, 0, 0, 0, [  
                        { offset: 0, color: '#f59e0b' },  
                        { offset: 1, color: '#d97706' }  
                    ]),  
                    borderRadius: 4  
                }  
            }]  
        }, true);  
    }  

    function simulateCrypto() {  
        Object.keys(cryptoBaseData).forEach(key => {  
            const item = cryptoBaseData[key];  
            item.base += (Math.random() - 0.498) * item.base * item.seed;  
            item.change += (Math.random() - 0.5) * 0.05;  

            const priceEl = document.getElementById(`${key}-price`);  
            const changeEl = document.getElementById(`${key}-change`);  
            
            if (priceEl && changeEl) {  
                priceEl.innerText = item.base > 1000 ?   
                    item.base.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}) :   
                    item.base.toFixed(2);  
                
                const sign = item.change >= 0 ? "+" : "";  
                changeEl.innerText = `${sign}${item.change.toFixed(2)}%`;  

                const colorClass = item.change >= 0 ? "up" : "down";  
                priceEl.className = `crypto-price ${colorClass}`;  
                changeEl.className = `crypto-change ${colorClass}`;  
            }  
        });  
    }  
</script>  
