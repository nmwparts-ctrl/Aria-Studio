    print(f"🎤 Voice upload: POST /upload_voice")
    print(f"📹 Video upload: POST /upload_video")
    print(f"📊 Status query: GET /get_data or /get_ai_text")
    print("=" * 50)
    app.run(host='0.0.0.0', port=8080, threaded=True)
